                  href={socialLinks.linkedin}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="btn btn-circle btn-ghost"
                  aria-label="LinkedIn"
                >
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
