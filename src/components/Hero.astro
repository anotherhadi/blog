            )}
            {socialLinks.kofi && (
              <div class="tooltip" data-tip="Ko-fi - Support me">
                <a
                  href={socialLinks.kofi}
                  class="btn btn-circle btn-ghost"
                  aria-label="Ko-fi"
                  target="_blank"
                >
                  <svg
                    class="size-6"
                    viewBox="0 0 241 194"
                    fill="none"
                    xmlns="http://www.w3.org/2000/svg"
                  >
                    <g clip-path="url(#clip0_245_13)">
