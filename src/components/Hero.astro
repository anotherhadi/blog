            {socialLinks.gitea && (
              <div class="tooltip" data-tip="Gitea">
                <a
                  href={socialLinks.gitea}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="btn btn-circle btn-ghost"
                  aria-label="Gitea"
