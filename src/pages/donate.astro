---
import Layout from "../layouts/Layout.astro";

const lightningAddress = "hadi@hadi.icu";
const bolt12Offer =
  "";
---

<Layout title="donate - hadi's site">
  <h1 class="text-2xl font-bold mb-4">donate</h1>
  <p class="leading-relaxed">
    if you want to send sats, my lightning address is:
    <code class="text-accent">{lightningAddress}</code>
  </p>

  <p class="mt-8 leading-relaxed">
    if your wallet can't resolve the address for some reason, here's the raw
    bolt12 offer as a fallback:
    <code class="text-accent break-all text-sm">{bolt12Offer}</code>
  </p>
</Layout>
